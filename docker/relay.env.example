# Copy to docker/.env (gitignored) and fill in.

# DNS name pointing at this machine (A/AAAA record), e.g. relay.example.com.
RELAY_DOMAIN=relay.example.com

# Invite code needed to register a space on this relay. Make it long and
# random, e.g. `openssl rand -base64 24`. Give it only to yourself.
RELAY_INVITE=change-me

# Optional limits.
# RELAY_MAX_SPACE_MB=256
# RELAY_MAX_SPACES=20
# RELAY_RETENTION_DAYS=30

# Only for `--profile tunnel` (Cloudflare Tunnel instead of Caddy).
# CLOUDFLARE_TUNNEL_TOKEN=
