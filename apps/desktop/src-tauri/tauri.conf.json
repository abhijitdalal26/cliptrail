{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipTrail",
  "mainBinaryName": "cliptrail",
  "version": "0.1.0",
  "identifier": "dev.cliptrail.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzMDVFMDkwQkI3OTU5RTIKUldUaVdYbTdrT0FGTXhQU3ZoQWdxY00xNTFhOWkySEFnMWFKZWMrWXJTMmhXVFlvZnZaYVRVMk0K",
      "endpoints": [
        "https://github.com/abhijitdalal26/cliptrail/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg", "app"],
    "category": "Utility",
    "shortDescription": "Clipboard history that remembers everything you copy",
    "longDescription": "ClipTrail keeps a searchable, local-first history of everything you copy: links, code, text, images and files, grouped by day.",
    "copyright": "ClipTrail contributors",
    "license": "MIT OR Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": { "windowPosition": { "x": 200, "y": 120 }, "appPosition": { "x": 160, "y": 170 }, "applicationFolderPosition": { "x": 480, "y": 170 } }
    },
    "linux": {
      "deb": { "depends": ["libxdo3"] }
    }
  }
}
