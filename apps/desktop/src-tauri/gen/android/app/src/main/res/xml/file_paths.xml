<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <external-path name="my_images" path="." />
  <cache-path name="my_cache_images" path="." />
  <!-- ClipTrail: copying an image clip puts a content:// URI on the clipboard. Stored images are
       encrypted, so the Rust side writes a plain copy of the one being copied here
       (src/mobile/commands.rs, CLIPBOARD_OUT_DIR). -->
  <files-path name="clip_out" path="clipboard-out/" />
</paths>
